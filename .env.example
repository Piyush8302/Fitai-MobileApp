# Copy to .env.local (gitignored) to point a LOCAL run at a different backend.
# Without it, the app falls back to the production backend.
#
#   staging : https://fitai-backend-staging.onrender.com   (dev branch + test DB)
#   prod    : https://fitai-backend-icbh.onrender.com      (real clients — careful)
#
# EXPO_PUBLIC_* is inlined at build time, so reload the app after changing it.
# EAS builds do NOT read this file (it is gitignored and never uploaded) —
# they take the URL from the `env` block of the eas.json build profile.
EXPO_PUBLIC_API_URL=https://fitai-backend-staging.onrender.com
